# SQLite file. Created and migrated on first start.
DATABASE_PATH=./data/app.sqlite

# Chat model: "openrouter" (default) or "ollama" (local, no key).
LLM_PROVIDER=openrouter

# OpenRouter: your key from https://openrouter.ai/keys. Prompts, including the retrieved code,
# are sent to OpenRouter and the model's provider; free models may log them, so do not index
# private code with a free model.
OPENROUTER_API_KEY=

# Empty uses the default: nvidia/nemotron-3-ultra-550b-a55b:free on OpenRouter, llama3.1 on Ollama.
# For Ollama, set a model you have pulled, e.g. LLM_MODEL=gemma4:12b after `ollama pull gemma4:12b`.
LLM_MODEL=

# Ollama only, when it is not on this machine's default port.
OLLAMA_BASE_URL=http://localhost:11434/v1
